FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    IN_DOCKER=1

WORKDIR /app

COPY pyproject.toml ./
COPY app ./app
COPY tests ./tests
COPY migrations ./migrations
COPY alembic.ini ./

RUN pip install --no-cache-dir ".[dev]"

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
