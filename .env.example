# Copiar a .env y completar los valores. NUNCA commitear .env.
# Generar claves: openssl rand -hex 32

# --- Base de datos (servicio `db` de docker-compose, postgres:15-alpine) ---
DB_USER=turnos
DB_PASSWORD=change-me-openssl-rand-hex-32
DB_NAME=turnos
# Puerto de exposición en el host. Default 5432; si el host ya tiene otro
# PostgreSQL escuchando en 5432, cambiar a 5433 (el interno del servicio `db`
# sigue siendo 5432; sólo cambia el bind de desarrollo).
DB_PORT=5432
# Apunta al servicio `db` de la red interna de compose, NO a localhost
DATABASE_URL=postgresql://turnos:change-me-openssl-rand-hex-32@db:5432/turnos

# --- Seguridad (variables separadas por diseño: DD-09 / 08_arquitectura_propuesta.md) ---
# openssl rand -hex 32
SECRET_KEY=change-me-secret-openssl-rand-hex-32
# openssl rand -hex 32  (distinta de SECRET_KEY: cifrado de datos de salud)
ENCRYPTION_KEY=change-me-encryption-openssl-rand-hex-32

# --- Sesión / cookies ---
TOKEN_TTL_HOURS=12
COOKIE_SECURE=false

# --- Entorno / logging ---
APP_ENV=development
LOG_LEVEL=INFO
